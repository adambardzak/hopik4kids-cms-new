# Backend (Spring Boot) — required in production (SPRING_PROFILES_ACTIVE=prod).
# The prod profile has NO defaults for secrets; the app fails fast if any are missing.

# Database
DB_URL=jdbc:postgresql://postgres:5432/hopik4kids
DB_USER=hopik
DB_PASSWORD=change-me-strong

# Secrets (generate strong values!)
#   PERSONAL_ID_KEY: Base64 of a 32-byte key, e.g. `openssl rand -base64 32`
#   JWT_SECRET:      Base64 of >=32 bytes, e.g. `openssl rand -base64 48`
#   REGISTRATION_API_KEY: shared secret between the website server and this backend,
#                         e.g. `openssl rand -base64 32`. Only the website's server knows it.
PERSONAL_ID_KEY=
JWT_SECRET=
JWT_TTL_SECONDS=86400
REGISTRATION_API_KEY=

# First owner seeded on empty DB (change the password immediately after first login)
BOOTSTRAP_OWNER_EMAIL=owner@hopik4kids.cz
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_PASSWORD=

# URLs / CORS
ADMIN_BASE_URL=https://admin.hopik4kids.cz
CORS_ALLOWED_ORIGINS=https://hopik4kids.cz,https://admin.hopik4kids.cz
MEDIA_BASE_URL=https://api.hopik4kids.cz/media
MEDIA_DIR=/data/media

# SMTP (system emails: invitations, password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_FROM=no-reply@hopik4kids.cz

# --- Frontend (Next.js admin) ---
# BACKEND_URL: internal URL of the backend for server-side calls (BFF)
BACKEND_URL=http://backend:8080
